# Open-Generative-AI - Project aliases and functions
# All commands defined here, sourced by .salias
# Run 'help' to see all available commands

# ── Help ──
function help
    clear
    cat /home/dev/work/media/Open-Generative-AI/.salias_help.txt
end

# ── Setup ──
alias setup='npm run setup'

# ── Dev servers ──
alias dev='npm run dev'
alias edev='npm run electron:dev'

# ── Build ──
alias build='npm run build'
alias bpkg='npm run build:packages'
alias bstudio='npm run build:studio'
alias ebuild='npm run electron:build:linux'

# ── Production / lint ──
alias serve='npm run start'
alias lint='npm run lint'

# ── Tests ──
# 'test' is a fish builtin — using 'tests' to avoid shadowing it
alias tests='node --test tests/'

# ── Fork Sync ──
# gitupdate is the global fish function (~/.config/fish/functions/gitupdate.fish).
# This file used to carry a copy with no dirty guard and no rebase error check,
# which force-pushed even when the rebase had stopped on a conflict. The global
# version guards both and re-syncs submodules itself. Do NOT redefine it here:
# a local definition is sourced on dir-entry and shadows the global one.
